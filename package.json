{
  "name": "@antadesign/anta",
  "version": "0.3.36",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "NOTICES.md",
    "theme-antithesis-license.md"
  ],
  "packageManager": "pnpm@10.11.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "default": "./dist/elements/index.js"
    },
    "./elements/*.css": "./dist/elements/*.css",
    "./elements/*": {
      "types": "./dist/elements/*.d.ts",
      "default": "./dist/elements/*.js"
    },
    "./bundle": {
      "types": "./dist/bundle.d.ts",
      "default": "./dist/bundle.js"
    },
    "./anta_helpers": {
      "types": "./dist/anta_helpers.d.ts",
      "default": "./dist/anta_helpers.js"
    },
    "./general_types": {
      "types": "./dist/general_types.d.ts",
      "default": "./dist/general_types.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./reset.css": "./dist/reset.css",
    "./bundle.css": "./dist/bundle.css",
    "./components/Select.css": "./dist/components/Select.css",
    "./components/select.css": "./dist/components/Select.css",
    "./components/select-parts.css": "./dist/components/Select.css",
    "./theme-antune.css": "./dist/theme-antune.css",
    "./theme-antithesis.css": "./dist/theme-antithesis.css",
    "./generate-icons.mjs": "./dist/generate-icons.mjs",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "build": "rm -rf dist && pnpm run build:js && pnpm run build:css && pnpm run build:bundle && pnpm run build:types && pnpm run build:docs",
    "build:dev": "pnpm run build:js && pnpm run build:css:dev && pnpm run build:bundle && pnpm run build:types",
    "build:css": "esbuild $(find src -name '*.css') --minify --outdir=dist --outbase=src && cp scripts/generate-icons.mjs dist/",
    "build:css:dev": "find src -name '*.css' | while IFS= read -r f; do d=\"dist/${f#src/}\"; mkdir -p \"$(dirname \"$d\")\"; cp \"$f\" \"$d\"; done && cp scripts/generate-icons.mjs dist/",
    "build:js": "esbuild $(find src \\( -name '*.ts' -o -name '*.tsx' \\) ! -name '*.d.ts') --outdir=dist --outbase=src --jsx=automatic --jsx-import-source=@antadesign/anta --format=esm --target=ES2022 --loader:.css=global-css",
    "build:bundle": "node scripts/build-bundle.mjs",
    "build:types": "tsc -p src/tsconfig.json",
    "build:docs": "pnpm --filter anta-site run docs:api && pnpm --filter anta-site run docs:pages && node scripts/generate-package-docs.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "dev": "node scripts/dev.mjs",
    "docs-fix": "node scripts/docs-fix.mjs",
    "docs-review": "node scripts/docs-review.mjs",
    "dev:run": "echo $$ > \"$ANTA_DEV_PID_FILE\"; trap 'rm -f \"$ANTA_DEV_PID_FILE\"' EXIT; pnpm run build:dev && pnpm --filter @antadesign/stickers run build:dev && pnpm --filter @antadesign/plot run build:dev && pnpm --filter @antadesign/typedoc-theme run build:dev && (node scripts/dev-watch.mjs & pnpm --filter anta-site run dev:server & (if [ \"$ANTA_DEV_WRANGLER\" = \"1\" ]; then pnpm --filter anta-site run dev:search; fi) & wait)",
    "stop": "node scripts/dev-stop.mjs",
    "typecheck": "tsc --noEmit -p src/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:panel": "node --test tests/panel-csp.mjs",
    "test:panel:package": "node tests/panel-package.mjs",
    "test:dialog": "node --test tests/dialog-csp.mjs",
    "test:dialog:package": "node tests/dialog-package.mjs",
    "test:menu": "node --test tests/menu-csp.mjs",
    "test:menu:package": "node tests/menu-package.mjs",
    "test:input-autocomplete": "node --test tests/input-autocomplete-types.mjs tests/input-autocomplete-projection.mjs tests/input-autocomplete-csp.mjs",
    "test:input-autocomplete:package": "node tests/input-autocomplete-package.mjs",
    "test:select": "node --test tests/select-projection.mjs tests/select-csp.mjs",
    "test:select:package": "node tests/select-package.mjs",
    "test:copy": "node --test tests/copy-csp.mjs",
    "test:copy:package": "node tests/copy-package.mjs",
    "test:components": "node tests/components.mjs",
    "test:expander": "node --test tests/expander-csp.mjs",
    "test:expander:package": "node tests/expander-package.mjs",
    "test:banner": "node --test tests/banner-csp.mjs",
    "test:banner:package": "node tests/banner-package.mjs",
    "test:card": "node --test tests/card-csp.mjs",
    "test:progress": "node --test tests/progress-csp.mjs",
    "test:value-ownership:package": "node tests/value-ownership-package.mjs",
    "test:value-ownership": "node --test tests/value-ownership.mjs",
    "test:calendar": "node --test tests/calendar-controlled.mjs",
    "test:capture-input": "node --test tests/capture-input.test.mjs",
    "lint": "node scripts/lint-getters.mjs && node scripts/lint-css-layers.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm --filter anta-site run docs:api",
    "icons": "node scripts/generate-icons.mjs --input src/elements/icons --output src/elements --name a-icon.shapes --internal",
    "clean": "rm -rf dist",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build:docs",
    "test:fuzz_component": "node tests/pbt/run.ts",
    "test:consumers": "node tests/consumers/run.mjs",
    "test:input": "node --test tests/input-csp.mjs",
    "test:input:package": "node tests/input-package.mjs",
    "test:tooltip": "node --test tests/tooltip-csp.mjs",
    "test:tooltip:package": "node tests/tooltip-package.mjs",
    "test:toaster": "node --test tests/toaster-csp.mjs",
    "test:toaster:package": "node tests/toaster-package.mjs",
    "test:text": "node --test tests/text-csp.mjs",
    "test:input-time": "node --test tests/input-time-csp.mjs",
    "test:input-time:package": "node tests/input-time-package.mjs",
    "test:selection": "node --test tests/selection-projection.mjs tests/selection-value.mjs",
    "test:selection:package": "node tests/selection-package.mjs",
    "test:slider": "node --test tests/slider-projection.mjs tests/slider-csp.mjs",
    "test:slider:package": "node tests/slider-package.mjs",
    "test:stickers": "node --test tests/stickers-csp.mjs",
    "test:stickers:package": "node tests/stickers-package.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "nodemon": "3.1.14",
    "react": "19.3.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "es-toolkit": "1.52.0",
    "tabbable": "6.5.0",
    "temporal-polyfill": "1.0.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
