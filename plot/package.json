{
  "name": "@antadesign/plot",
  "version": "0.1.4-dev.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/entries/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/types/entries/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./auto": {
      "types": "./dist/types/entries/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./plot.css": "./dist/plot.css",
    "./elements": {
      "types": "./dist/types/entries/elements.d.ts",
      "import": "./dist/elements.js"
    },
    "./elements/a-plot": {
      "types": "./dist/types/entries/elements/a-plot.d.ts",
      "import": "./dist/elements/a-plot.js"
    },
    "./elements/a-plot-surface": {
      "types": "./dist/types/entries/elements/a-plot-surface.d.ts",
      "import": "./dist/elements/a-plot-surface.js"
    }
  },
  "sideEffects": [
    "./dist/auto.js",
    "./dist/elements.js",
    "./dist/elements/*.js",
    "./dist/*.css",
    "./dist/chunks/*.js",
    "./src/entries/elements.ts",
    "./src/entries/elements/*.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "pnpm run build",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false -p tsconfig.build.json",
    "check:package": "node scripts/verify-package.mjs",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "test:font": "node --test tests/font.test.mjs",
    "test:registration": "node --test tests/registration.test.mjs",
    "test:components": "node --test tests/components.test.mjs",
    "test:browser": "node --test tests/components.browser.test.mjs",
    "test:axes": "node --test tests/axes.test.mjs"
  },
  "dependencies": {
    "@types/d3-scale": "4.0.9",
    "@types/d3-time": "3.0.4",
    "chroma-js": "3.2.0",
    "d3-scale": "4.0.2",
    "d3-time": "3.1.0",
    "es-toolkit": "1.52.0"
  },
  "peerDependencies": {
    "@antadesign/anta": "^0.3.30",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@antadesign/anta": "workspace:*",
    "@types/chroma-js": "3.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "packageManager": "pnpm@10.11.1",
  "main": "dist/index.js",
  "types": "dist/types/entries/index.d.ts",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
