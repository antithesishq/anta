# PostHog analytics for the docs site. Copy this file to `.env` and fill in
# the real values (`.env` is gitignored). Get the project token from the
# PostHog project settings: Project settings → General → Project API key.
PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
