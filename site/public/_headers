# Revalidate documents and assets with stable URLs before reusing them, so
# requests after a deployment receive the current version. Unchanged files
# can still use conditional requests instead of downloading again.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Vite fingerprints these files, so a changed asset has a new URL. Remove the
# inherited document policy before setting their long-lived immutable policy.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The playground runtime uses a content hash in its filename for the same
# reason. Other iframe files (and esbuild.wasm) revalidate with the default above.
/iframe/iframe-app.*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
