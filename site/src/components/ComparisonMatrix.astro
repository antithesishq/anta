---
// At-a-glance matrix for the /comparison page: one row per system, columns
// for the facts that decide adoption (frameworks, styling, license, browser
// support). Its rows use the coverage matrix's shared system order. The Anta
// row is highlighted. Horizontal scrolling stays inside the matrix on compact
// screens.
import { COVERAGE_SYSTEMS } from './comparison-data'
---

<div class="matrix-scroll">
  <table class="matrix">
    <thead>
      <tr>
        <th scope="col" class="sys-col">System</th>
        <th scope="col">Frameworks</th>
        <th scope="col">Styling</th>
        <th scope="col">License</th>
        <th scope="col">Browser support</th>
      </tr>
    </thead>
    <tbody>
      {COVERAGE_SYSTEMS.map((s) => (
        <tr class:list={[{ anta: s.anta }]}>
          <th scope="row" class="sys-col">
            <span class="sys-name">
              {s.nameParts
                ? s.nameParts.map((part, index) => <>
                    {index > 0 && <span aria-hidden="true"> + </span>}
                    <a href={part.href} target="_blank" rel="noopener">{part.label}</a>
                  </>)
                : <a href={s.docs} target="_blank" rel="noopener">{s.short ?? s.name}</a>}
            </span>
            <span class="sys-ver">{s.version}</span>
          </th>
          <td>
            {s.frameworks}
            {s.frameworksNote && <span class="fw-note">({s.frameworksNote})</span>}
          </td>
          <td>{s.styling}</td>
          <td>{s.license}</td>
          <td title={s.browsers}>{s.browserBaselineYear ?? '—'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .matrix-scroll {
    /* At compact widths this is a real two-axis data-grid viewport, so the
       header has a vertical scrollport to stick within. On wide tracks the
       container becomes non-scrolling below and the header sticks to the page. */
    max-block-size: min(720px, calc(100dvh - 32px));
    overflow: auto;
    scrollbar-gutter: stable;
    margin-block: 24px;
  }

  /* The five-column matrix needs 800px. Once that fits, let the page own vertical
     scrolling again and keep only the document-level sticky header. */
  @container (min-width: 800px) {
    .matrix-scroll {
      max-block-size: none;
      overflow: visible;
    }
  }

  .matrix {
    border-collapse: separate;
    border-spacing: 0;
    /* Fill the available comparison lane. Intrinsic sizing lets each fact
       column use the space its content needs; the scroll container handles
       smaller viewports. */
    width: 100%;
    min-width: 800px;
    font-size: 13px;
    line-height: 1.4;
  }

  .matrix th,
  .matrix td {
    text-align: left;
    vertical-align: top;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border-5);
  }

  .matrix thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--bg-base);
    color: var(--text-3);
    font-weight: 550;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--border-4);
    white-space: nowrap;
  }

  /* First column: the system name + version. Sticky so it stays anchored
     while the fact columns scroll horizontally. */
  .sys-col {
    position: sticky;
    left: 0;
    z-index: 1;
    /* Match ordinary cells rather than making the pinned system column look
       selected. It remains opaque so scrolled fact cells do not show through. */
    background: var(--bg-base);
    min-width: 168px;
  }
  thead .sys-col {
    z-index: 3;
  }

  .sys-name {
    display: block;
    font-weight: 550;
    color: var(--text-1);
  }
  .sys-ver {
    display: block;
    margin-top: 2px;
    font-size: 11px;
    font-weight: 400;
    color: var(--text-3);
    font-family: var(--monospace, ui-monospace, monospace);
  }

  .matrix td {
    color: var(--text-2);
  }

  /* Secondary framework reach on its own muted line under the primary. */
  .fw-note {
    display: block;
    margin-top: 2px;
    color: var(--text-4);
    font-size: 12px;
  }

  /* Anta row: brand tint across the row, including the sticky name cell,
     so it reads as the reference point the page is written around. */
  .matrix tbody tr.anta th,
  .matrix tbody tr.anta td {
    background: var(--bg-5-brand);
    border-bottom-color: var(--border-4-brand);
  }
  .matrix tbody tr.anta .sys-name {
    color: var(--text-1-brand);
  }
  .matrix tbody tr.anta td {
    color: var(--text-1);
  }
</style>
