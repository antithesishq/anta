---
// Component-coverage matrix: one row per grouped component category, one
// column per system, so you can read across a row to see who ships a Table
// or down the Anta column to see its shape. Marks are honest and grouped by
// job (see comparison-data.ts). Anta's column is highlighted; the category
// column and the header row are sticky so the wide grid stays legible while
// it scrolls horizontally.
import { CATEGORIES, COVERAGE, COVERAGE_SYSTEMS, COVERAGE_URLS, type Mark } from './comparison-data'

const MARK: Record<Mark | 'none', { glyph: string; label: string; cls: string }> = {
  yes: { glyph: '✓', label: 'Included', cls: 'm-yes' },
  partial: { glyph: '~', label: 'Basic or community-only', cls: 'm-partial' },
  paid: { glyph: '$', label: 'Paid / commercial tier', cls: 'm-paid' },
  no: { glyph: '·', label: 'Not shipped', cls: 'm-no' },
  none: { glyph: '·', label: 'Not shipped', cls: 'm-no' },
}

// A shipped cell renders an Anta tertiary check-icon Button; its `tone` carries
// the tier color (included / basic / paid) so the check still reads by tier.
const MARK_TONE: Partial<Record<Mark, string>> = {
  yes: 'success',
  partial: 'warning',
  paid: 'info',
}

// Anta's own coverage marks link to the matching component page. The category
// labels above remain static text so the first column is not interactive.
const ANTA_SLUG: Record<string, string> = {
  button: 'button', textinput: 'input', select: 'select', combobox: 'input-autocomplete',
  choice: 'checkbox', slider: 'slider',
  datetime: 'input-date', tabs: 'tabs', menu: 'menu', tooltip: 'tooltip',
  dialog: 'dialog', toast: 'toaster', accordion: 'expander', table: 'table', tag: 'tag', avatar: 'avatar', card: 'card', progress: 'progress', steps: 'steps', nav: 'breadcrumbs',
  icons: 'icon', typography: 'text', utilities: 'box',
}

---

<div class="cov-scroll">
  <table class="cov">
    <thead>
      <tr>
        <th scope="col" class="cat-col">Component</th>
        {COVERAGE_SYSTEMS.map((s) => (
          <th scope="col" class:list={['sys-head', { anta: s.anta }]}>
            <a href={s.docs} target="_blank" rel="noopener" class="sys-head-label" aria-label={s.name} title={s.name}>{s.short ?? s.name}</a>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {CATEGORIES.map((c) => (
        <tr>
          <th scope="row" class="cat-col">
            <span class="cat-label">{c.label}</span>
            <span class="cat-members">{c.members}</span>
          </th>
          {COVERAGE_SYSTEMS.map((s) => {
            const raw = COVERAGE[s.id]?.[c.id]
            const m = MARK[raw ?? 'none']
            const shipped = !!raw && raw !== 'no'
            // Link a shipped cell to that system's doc page for the job: Anta
            // to our own component page (internal), peers to their external
            // docs. A shipped cell with no known page renders a static check.
            const href = shipped
              ? s.anta
                ? ANTA_SLUG[c.id] ? `/${ANTA_SLUG[c.id]}` : undefined
                : COVERAGE_URLS[s.id]?.[c.id]
              : undefined
            const tone = MARK_TONE[raw ?? 'no']
            const iconShape = raw === 'paid' ? 'dollar-sign' : 'check'
            const example = c.examples?.[s.id]
            const title = `${s.name} — ${c.label}: ${m.label}${example ? ` (${example})` : ''}`
            return (
              <td class:list={['mark', m.cls, { anta: s.anta }]}>
                {shipped && href ? (
                  // Shipped + has a doc page → an Anta tertiary tier-icon Button
                  // as an anchor (href → `<a role="button" data-anta>`), links out.
                  <a
                    href={href}
                    data-anta=""
                    role="button"
                    priority="tertiary"
                    tone={tone}
                    size="large"
                    class="mark-btn"
                    target={s.anta ? undefined : '_blank'}
                    rel={s.anta ? undefined : 'noopener'}
                    aria-label={`${title} — open docs`}
                  >
                    <a-icon shape={iconShape} aria-hidden="true"></a-icon>
                  </a>
                ) : shipped ? (
                  // Shipped, but no doc page — the same tier icon with no link.
                  <a-button priority="tertiary" tone={tone} size="large" tabindex="-1" aria-hidden="true" class="mark-btn">
                    <a-icon shape={iconShape} aria-hidden="true"></a-icon>
                  </a-button>
                ) : (
                  // Not shipped → a critical-tone x-icon button, no link.
                  <a-button priority="tertiary" tone="critical" size="large" tabindex="-1" aria-hidden="true" class="mark-btn">
                    <a-icon shape="x" aria-hidden="true"></a-icon>
                  </a-button>
                )}
                <span class="sr-only">{m.label}</span>
                <a-tooltip class="mark-tip">{title}</a-tooltip>
              </td>
            )
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  /* Compact tracks use a genuine two-axis data-grid viewport. That gives the
     sticky header a vertical scrollport and keeps horizontal movement local.
     The wide-track rule below removes the scrollport, so the header instead
     sticks to the document while the full table is visible. */
  .cov-scroll {
    max-block-size: min(720px, calc(100dvh - 32px));
    overflow: auto;
    scrollbar-gutter: stable;
    margin-block: 24px 8px;
  }

  /* The 810px table minimum leaves 630px after the 180px category column:
     about 48px for each of the 13 equal system columns. Keep the viewport
     only while that minimum needs horizontal scrolling. */
  @container (min-width: 810px) {
    .cov-scroll {
      max-block-size: none;
      overflow: visible;
    }
  }

  .cov {
    border-collapse: separate;
    border-spacing: 0;
    /* Fixed layout gives the category its 180px measure and divides all
       remaining room evenly between the 13 system columns. */
    table-layout: fixed;
    width: max(100%, 810px);
    min-width: 100%;
    font-size: 13px;
  }

  .cov th,
  .cov td {
    /* Tight side padding so a large (32px) icon button fits a 40px column. */
    padding: 8px 4px;
    border-bottom: 1px solid var(--border-5);
    white-space: nowrap;
  }

  /* Header row: system names, sticky to the top on vertical scroll. */
  .cov thead .sys-head {
    position: sticky;
    top: 0;
    z-index: 2;
    /* With no width of its own, each system header receives an equal share of
       the table width after the fixed category column is accounted for. */
    white-space: nowrap;
    background: var(--bg-base);
    color: var(--text-2);
    font-weight: 550;
    text-align: center;
    border-bottom: 1px solid var(--border-4);
    vertical-align: bottom;
  }
  .sys-head-label {
    display: block;
    min-width: 0;
    font-size: 11px;
    letter-spacing: -0.01em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: inherit;
  }

  /* First column: the grouped category, sticky to the left on horizontal
     scroll. Label on top, grouped members underneath. */
  .cat-col {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--bg-base);
    border-inline-end: 1px solid var(--border-4);
    text-align: left;
    /* The label column keeps a generous fixed measure; its contents wrap and
       clip inside the sticky track rather than painting across its divider. */
    width: 180px;
    overflow: hidden;
    overflow-wrap: anywhere;
    white-space: normal;
  }
  thead .cat-col {
    /* The top-left corner: pin it to the top too (not just left) so "Component"
       stays put on vertical scroll alongside the system-name headers. z-index 3
       keeps it above both the sticky header row (2) and the sticky column (1). */
    top: 0;
    z-index: 3;
    background: var(--bg-base);
  }
  .cat-label {
    display: block;
    font-weight: 500;
    color: var(--text-1);
  }
  .cat-members {
    display: block;
    margin-top: 1px;
    font-size: 11px;
    font-weight: 400;
    color: var(--text-3);
    overflow-wrap: anywhere;
  }

  /* Mark cells. */
  .mark {
    text-align: center;
    font-weight: 600;
    min-width: 30px;
  }
  .m-yes { color: var(--text-1-success); }
  .m-partial { color: var(--text-2-warning); }
  .m-paid { color: var(--text-2-info); }
  .m-no { color: var(--text-5); font-weight: 400; }

  /* Shipped cells render an Anta tertiary tier-icon Button (link) or, when
     there's no doc page, a static tier icon. The Button carries its own tone
     color; the static icon inherits the cell's tier color via currentColor. */
  .mark-btn {
    display: inline-flex;
  }

  /* Anta's column is no longer tinted by default — only its header name keeps
     the brand color as a light identity cue. It highlights on hover like any
     other column. */
  .cov thead .sys-head.anta {
    color: var(--text-1-brand);
  }

  /* Highlight the hovered cell's column. The script toggles `col-hl` on
     every cell in the column; these selectors sit after the base cell
     backgrounds so they win on the sticky header and category cells too
     (equal specificity, later in source). */
  .cov th.col-hl,
  .cov td.col-hl {
    background: var(--bg-3);
  }

  /* Keep availability tiers visible when a column is highlighted. */
  .cov td.m-partial {
    background: var(--bg-3-warning);
  }
  .cov td.m-no {
    background: var(--bg-4-critical);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // Highlight the hovered cell's column. Plain class toggling on an in-DOM
  // table (this docs component isn't worker-rendered), driven by delegated
  // pointer events so it costs nothing until the pointer enters. `cellIndex`
  // / `rows` / `cells` are native table APIs; the header cell in each column
  // is included, so hovering also tints the system name on top.
  // Scanned on astro:page-load (the initial load and every swap): the module
  // runs once per session while the tables re-render on each navigation.
  document.addEventListener('astro:page-load', () => {
    for (const table of document.querySelectorAll<HTMLTableElement>('table.cov')) {
      let col = -1
      const clear = () => {
        for (const el of table.querySelectorAll('.col-hl')) el.classList.remove('col-hl')
        col = -1
      }
      table.addEventListener('mouseover', (e) => {
        const cell = (e.target as Element).closest('th, td')
        if (!cell || !table.contains(cell)) return
        const nextCol = (cell as HTMLTableCellElement).cellIndex
        if (nextCol === 0) {
          clear()
          return
        }
        if (nextCol === col) return
        clear()
        col = nextCol
        for (const r of table.rows) r.cells[col]?.classList.add('col-hl')
      })
      table.addEventListener('mouseleave', clear)
    }
  })
</script>
