---
// A specimen of plain HTML — every tag `reset.css` has an opinion about, plus a
// few it deliberately leaves alone, rendered live so the page shows the baseline
// rather than describing it.
//
// Kept as a component rather than written into the MDX for two reasons: the
// headings here are samples, not sections, and MDX would feed them to rehype-slug
// and land "Heading two" in the page's table of contents; and the markup passes
// through untouched, so no remark paragraph handling can rearrange it.
---

<div class="specimen">
  <h2>Heading two</h2>
  <h3>Heading three</h3>
  <h4>Heading four</h4>
  <p>
    Body text with <a href="#specimen">a link</a>, <strong>strong</strong>,
    <em>em</em>, <code>inline code</code>, <kbd>Ctrl</kbd>, <samp>samp output</samp>,
    <dfn>a defined term</dfn>, <small>small print</small>, <mark>mark</mark>,
    <abbr title="Cascading Style Sheets">abbr</abbr>, <del>deleted</del>,
    <ins>inserted</ins>, the variable <var>w</var>, H<sub>2</sub>O and x<sup>2</sup>.
  </p>
  <blockquote>A blockquote, marked by a rule rather than an indent.</blockquote>
  <ul>
    <li>Unordered item</li>
    <li>Second item</li>
  </ul>
  <ol>
    <li>Ordered item</li>
    <li>Second item</li>
  </ol>
  <dl>
    <dt>Term</dt>
    <dd>Definition</dd>
  </dl>
  <pre><code>a code block</code></pre>
  <table>
    <caption>Table caption</caption>
    <thead>
      <tr><th>Header</th><th>Another</th></tr>
    </thead>
    <tbody>
      <tr><td>Cell</td><td>Cell</td></tr>
      <tr><td>Cell</td><td>Cell</td></tr>
    </tbody>
  </table>
  <figure><figcaption>A figcaption</figcaption></figure>
  <hr />
</div>

<style>
  /* A quiet frame so the sample reads as a specimen and not as page copy. The
     tags inside are left entirely to the reset — no rule here targets them. */
  .specimen {
    padding: 20px 24px;
    border: 1px solid var(--border-4);
    border-radius: 6px;
    margin-bottom: 1.5em;
  }

  /* The sample's first and last elements shouldn't push the frame open. */
  .specimen > :first-child { margin-block-start: 0; }
  .specimen > :last-child { margin-block-end: 0; }
</style>
