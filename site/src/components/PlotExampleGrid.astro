<div class="plot-example-grid">
  <slot />
</div>

<style>
  .plot-example-grid :global(.columns) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: 32px 20px;
    align-items: stretch;
  }

  /* Share heading, description, preview, and code rows across each pair. */
  .plot-example-grid :global(.columns > .col) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: subgrid;
    row-gap: 0;
    grid-row: span 4;
    min-width: 0;
  }

  /* Explicit placement keeps the code panel below the preview in the subgrid. */
  .plot-example-grid :global(.col > h5) { grid-row: 1; }
  .plot-example-grid :global(.col > p) { grid-row: 2; }
  .plot-example-grid :global(.col > .preview) { grid-row: 3; }
  .plot-example-grid :global(.col > .expressive-code) { grid-row: 4; }

  .plot-example-grid :global(.col > h5),
  .plot-example-grid :global(.col > p) {
    padding-bottom: 16px;
  }

  .plot-example-grid :global(.col > *) {
    margin-block: 0;
  }
</style>
