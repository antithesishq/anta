---
/**
 * Renders its children inside a bordered, padded panel so MDX code
 * blocks can sit *below* a live preview of the same JSX. Pure SSR —
 * no client hydration; relies on the host page's
 * `@antadesign/anta/elements` registration to hydrate any `<a-*>`
 * custom elements inside.
 *
 * `cols` switches the panel from the default wrap-flex to a centered
 * grid of N equal-gap columns — handy when you want children to land
 * on tidy rows (e.g. two rows of three) without flex line-break hacks.
 */
interface Props {
  cols?: number
  /** Gap between previewed items. Any CSS length; defaults to 12px. */
  gap?: string
  /** Panel background. Any CSS color; defaults to `--bg-canvas`. */
  background?: string
  /** `align-items` for the flex layout; defaults to `center`. Pass `stretch`
   *  to make a wrapping row of items equal height. */
  align?: string
  /** Reserve a minimum panel height so a client-hydrated demo doesn't snap
   *  open from zero on load. Any CSS length (a number is read as px). Previews
   *  holding an island get a modest default; set this for taller demos to
   *  reserve their real height. */
  minHeight?: string | number
}
const { cols, gap, background, minHeight, align } = Astro.props
const mh = typeof minHeight === 'number' ? `${minHeight}px` : minHeight
const style = [
  cols ? `--preview-cols: ${cols}` : '',
  gap ? `gap: ${gap}` : '',
  background ? `background: ${background}` : '',
  align ? `align-items: ${align}` : '',
  mh ? `--preview-min-height: ${mh}` : '',
].filter(Boolean).join('; ') || undefined
---
<div class="preview" data-cols={cols} style={style}>
  <slot />
</div>

<style>
  .preview {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    border: 1px solid var(--border-5);
    border-radius: 6px;
    background: var(--bg-canvas);
    margin-bottom: 4px;
    min-height: var(--preview-min-height, auto);
  }

  /* A `client:only` island renders nothing server-side, so its preview
     collapses to zero height until hydration, then snaps open — a flash.
     Reserve a modest floor for those so the box is already there; the
     content grows into it, and a taller demo overrides via the `minHeight`
     prop (inline var wins). `client:load` / `client:visible` islands SSR at
     their real height, so they need no reserve and are left at natural
     height (matching by `client="only"` avoids over-reserving them). */
  .preview:has(astro-island[client="only"]) {
    --preview-min-height: 96px;
  }

  /* `cols` mode: a centered grid of N max-content columns. Same 12px
     gap on both axes — no doubled row gap from flex line-break spacers. */
  .preview[data-cols] {
    display: grid;
    grid-template-columns: repeat(var(--preview-cols), max-content);
    justify-content: center;
  }
  /* Grid cells stretch each button to the column width; center the
     button's own content so the label isn't left-aligned in the wider box. */
  .preview[data-cols] :global(a-button) {
    justify-content: center;
  }
</style>
