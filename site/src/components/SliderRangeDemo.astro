---
import Preview from './Preview.astro'
import SliderRangeDemo from './SliderRangeDemo'
---

<Preview direction="column" align="stretch" background="var(--bg-2)">
  <div class="range-demo">
    <SliderRangeDemo client:load />
  </div>
</Preview>

<style>
  .range-demo {
    width: min(100%, 560px);
    margin-inline: auto;
  }

  .range-demo :global(astro-island) { display: block; }

  .range-demo :global(.range-demo-output) {
    margin: 12px 0 0;
    color: var(--text-3);
  }
</style>
