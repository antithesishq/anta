---
// Static shell for the Colors page: section headings, descriptions, and
// theme-row layout, all tone-independent, so one page serves every tone.
// ToneTabs holds the picked tone and broadcasts `anta-colors-tone`; each
// SwatchGrid island re-renders its tokens in place. Switching never navigates
// or scrolls.
import s from './Swatches.module.css'
import SwatchGrid from './SwatchGrid.tsx'
import ToneTabs from './ToneTabs'
import { marked } from 'marked'
import { KINDS, TITLES, INTROS, TEXT_LINES, BACKGROUND_GUIDANCE, LINK_GUIDANCE, BORDER_GUIDANCE, type Kind } from './color-reference'

function guidance(markdown: string) {
  return marked.parse(markdown, { async: false }).replace(/<h3>([^<]+)<\/h3>/g, (_, title) => {
    const id = title.toLowerCase().replaceAll(' ', '-')
    return `<h3 id="${id}"><a href="#${id}" class="header-anchor muted">${title}</a></h3>`
  })
}

const slug = (k: Kind) => TITLES[k].toLowerCase()
---

<div class:list={[s.page, 'full-bleed']}>
  <div class={s.toneTabs}>
    <ToneTabs client:load />
  </div>

  {KINDS.map((kind) => (
    <section class={s.block}>
      <div class={s.blockHeading}>
        <h2 id={slug(kind)}>
          <a href={`#${slug(kind)}`} class="header-anchor muted">{TITLES[kind]}</a>
        </h2>
        <p>{INTROS[kind]}</p>
      </div>

      <div class={s.themeRows}>
        <div class:list={[s.themeRow, s.themeRowLight, 'light']}>
          <div class={s.themeLabel}>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.5" />
              <path d="M8 1.5v1.5M8 13v1.5M1.5 8h1.5M13 8h1.5M3.4 3.4l1.06 1.06M11.54 11.54l1.06 1.06M3.4 12.6l1.06-1.06M11.54 4.46l1.06-1.06" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            <span>Light theme</span>
          </div>
          <SwatchGrid kind={kind} client:load />
        </div>

        <div class:list={[s.themeRow, s.themeRowDark, 'dark']}>
          <div class={s.themeLabel}>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M14 9.5A6 6 0 0 1 6.5 2c0-.4 0-.7.1-1A6 6 0 1 0 15 8.4l-1 .1Z" fill="currentColor" />
              <circle cx="11.5" cy="3.5" r="0.7" fill="currentColor" />
              <circle cx="13.5" cy="6" r="0.5" fill="currentColor" />
            </svg>
            <span>Dark theme</span>
          </div>
          <SwatchGrid kind={kind} client:load />
        </div>
      </div>

      {kind === 'bg' && (
        <div class={s.description}>
          <Fragment set:html={guidance(BACKGROUND_GUIDANCE)} />
        </div>
      )}

      {kind === 'text' && (
        <div class={s.description}>
          {TEXT_LINES.map((l) => (
            <p style={`color: var(--${l.token})`}>
              <code>{l.token}</code> — {l.copy}
            </p>
          ))}

          <Fragment set:html={guidance(LINK_GUIDANCE)} />
        </div>
      )}

      {kind === 'border' && (
        <div class={s.description}>
          <Fragment set:html={guidance(BORDER_GUIDANCE)} />
        </div>
      )}
    </section>
  ))}
</div>
