---
import { COVERAGE_SYSTEMS } from './comparison-data'
---

<div class="cards">
  {COVERAGE_SYSTEMS.map((s) => (
    <section class:list={['card', { anta: s.anta }]}>
      <header class="card-head">
        <div class="card-identity">
          <h3 class="card-name" id={`sys-${s.id}`}>
            {s.nameParts
              ? s.nameParts.map((part, index) => <>
                  {index > 0 && <span aria-hidden="true"> + </span>}
                  <a href={part.href} target="_blank" rel="noopener">{part.label}</a>
                </>)
              : <a href={s.docs} target="_blank" rel="noopener">{s.name}</a>}
          </h3>
          <span class="card-ver">{s.version}</span>
        </div>
        <div class="card-facts">
          <span class="card-fact" tabindex="0" aria-describedby={`sys-${s.id}-size`}>
            Gzipped size <strong>{s.bundleSize}</strong>
            <a-tooltip id={`sys-${s.id}-size`}><span class="size-version">Measured: {s.bundleVersion}.</span>{s.bundleIncludes}</a-tooltip>
          </span>
          <span class="card-fact" tabindex="0" aria-describedby={`sys-${s.id}-browsers`}>
            Browser support <strong>{s.browserSupport}</strong>
            <a-tooltip id={`sys-${s.id}-browsers`}>{s.browsers}</a-tooltip>
          </span>
        </div>
      </header>
      <p class="card-tagline">{s.tagline}</p>
      <div class="card-cols">
        <div class="col-pros">
          <h4><a-icon shape="circle-check" class="head-icon"></a-icon>Strengths</h4>
          <ul>
            {s.pros.map((p) => <li>{p}</li>)}
          </ul>
        </div>
        <div class="col-cons">
          <h4><a-icon shape="info" class="head-icon"></a-icon>Trade-offs</h4>
          <ul>
            {s.cons.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </div>
      <p class="card-sources">
        Sources: {s.sources.map((source, index) => <>
          {index > 0 && ' · '}
          <a href={source.href}>{source.label}</a>
        </>)}
      </p>
    </section>
  ))}
</div>

<style>
  .cards {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-block: 24px;
  }

  .card {
    border: 1px solid var(--border-5);
    border-radius: 10px;
    padding: 20px 22px;
    background: var(--bg-canvas);
  }
  .card.anta {
    border-color: var(--border-3-brand);
    background: var(--bg-4-brand);
  }

  .card-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 12px 24px;
  }
  .card-identity {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 12px;
  }
  .card-name {
    margin: 0;
    font-size: 18px;
    line-height: 1.2;
  }
  .card-name a {
    color: var(--text-1);
  }
  .card.anta .card-name a {
    color: var(--text-1-brand);
  }
  .card-ver {
    font-size: 12px;
    font-weight: 400;
    color: var(--text-3);
    font-family: var(--monospace, ui-monospace, monospace);
  }

  .card-tagline {
    margin: 8px 0 14px;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.5;
  }

  .card-facts {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 16px;
  }
  .card-fact {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    color: var(--text-3);
    font-size: 11px;
    font-weight: 650;
    font-style: normal;
    font-variation-settings: inherit;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: help;
    border-radius: 3px;
  }
  .card-facts strong {
    color: var(--text-1);
    font-family: var(--monospace, ui-monospace, monospace);
    font-size: 12px;
    font-weight: 550;
    text-transform: none;
    letter-spacing: normal;
  }
  .size-version {
    display: block;
    margin-bottom: 4px;
  }

  .card-sources {
    margin: 16px 0 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-3);
  }

  .card-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 32px;
  }
  @container (max-width: 760px) {
    .card-head {
      grid-template-columns: 1fr;
    }
  }
  @container (max-width: 640px) {
    .card-cols {
      grid-template-columns: 1fr;
    }
  }

  .card-cols h4 {
    display: flex;
    align-items: center;
    gap: 5px;
    margin: 0 0 8px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-3);
  }
  /* a-icon draws with currentColor, so the heading's color tints the glyph.
     Sized a touch above the 12px label so the mark reads clearly. */
  .head-icon {
    --icon-size: 15px;
    flex-shrink: 0;
  }
  .col-pros h4 { color: var(--text-1-success); }
  .col-cons h4 { color: var(--text-2-warning); }

  .card-cols ul,
  .card-cols ol {
    margin: 0;
    padding-left: 2ch;
  }
  .card-cols li {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text-2);
  }
</style>
