---
import '@antadesign/anta/tokens.css'
import '@antadesign/anta/reset.css'
// Link every element's HOST / light-DOM CSS (border, background, gutter, tones,
// summary/details typography) as a render-blocking <head> stylesheet. Without
// it, that CSS only lands when the client-side `@antadesign/anta/elements`
// module runs (each `a-*.ts` does `import './a-*.css'`) — i.e. AFTER first
// paint — so an `<a-expander>` flashes as an unstyled box until the
// registration round-trip completes. We import only the stylesheets (never the
// JS barrel, which calls `customElements.define` and would crash SSR where
// `HTMLElement` is undefined), so the host chrome paints immediately; only the
// shadow-DOM internals still wait for upgrade. See element-host-styles.css.
import './element-host-styles.css'
import '../styles/base.css'
// Docs-site-only extra icon shapes (generated via Anta's generate-icons
// script), registered on `<a-icon>` per the "Adding your own icons" guide.
import '../icons/docs-icons.css'
import { ClientRouter } from 'astro:transitions'
import { Button, Icon } from '@antadesign/anta'
import PostHog from '../components/posthog.astro'
import { COMPONENT_SLUGS } from '../../lib/component-slugs'
import ThemeSwitcher from '../components/ThemeSwitcher.tsx'

interface Props {
  title?: string
  /** Cap the "On this page" TOC at this heading level (2 = h2 only). Omit for
   *  all levels. Set via an `.astro` page prop or MDX frontmatter. */
  tocMaxLevel?: number
  /** Drop the right "On this page" rail so the content spans the full width.
   *  For pages that manage their own wide layout (e.g. the theming lab). */
  hideToc?: boolean
  frontmatter?: { title?: string; tocMaxLevel?: number; hideToc?: boolean }
}

const title = Astro.props.title ?? Astro.props.frontmatter?.title ?? ''
const tocMaxLevel = Astro.props.tocMaxLevel ?? Astro.props.frontmatter?.tocMaxLevel
const hideToc = Astro.props.hideToc ?? Astro.props.frontmatter?.hideToc ?? false
const path = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isCurrent = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/'
  return h === path
}

// Fetch the latest published version from the npm registry at build time
// so the sidebar shield labels the current release without a runtime call.
// Prefer the stable `latest` dist-tag, falling back to `dev` only if no
// stable release exists yet. Any failure (offline, registry hiccup)
// silently degrades to a plain "npm" label.
let npmVersion: string | null = null
try {
  const res = await fetch('https://registry.npmjs.org/@antadesign/anta', {
    signal: AbortSignal.timeout(3000),
  })
  if (res.ok) {
    const data = await res.json()
    npmVersion = data?.['dist-tags']?.latest ?? data?.['dist-tags']?.dev ?? null
  }
} catch {}

// Resolve URLs against the site config (https://anta.design) so
// Open Graph / Twitter crawlers receive absolute URLs, and the canonical
// link always points at the production domain — Cloudflare Pages preview
// deployments (*.pages.dev) serve identical content and would otherwise
// compete in search indexes.
const ogImage = new URL('/og-image.png', Astro.site).href
const pageUrl = new URL(Astro.url.pathname, Astro.site).href
const pageTitle = title ? `${title} — Anta` : 'Anta'
const description = "Opinionated design system: global CSS tokens, framework-agnostic web components, and JSX wrappers for React and Preact."
// Keep local development free of analytics traffic and token configuration.
const shouldLoadPostHog = import.meta.env.PROD

// JSON-LD structured data. Every page declares the WebSite; component
// pages add a breadcrumb trail so search results show the site hierarchy.
const isComponentPage = COMPONENT_SLUGS.includes(Astro.url.pathname.replace(/^\/|\/$/g, ''))
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Anta',
    url: new URL('/', Astro.site).href,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: '@antadesign/anta',
    description,
    url: new URL('/', Astro.site).href,
    codeRepository: 'https://github.com/antithesishq/anta',
    programmingLanguage: 'TypeScript',
    runtimePlatform: ['React', 'Preact'],
  },
]
if (isComponentPage && title) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Anta', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
    ],
  })
}
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover so the layout spans the whole screen on notched /
        Dynamic-Island iPhones. Without it, Safari letterboxes the page in
        landscape — insetting the content away from the notch and painting the
        margins with the page background, so the UI looks like it doesn't use
        the full width. `env(safe-area-inset-*)` padding on `.layout` keeps
        content clear of the notch; the insets are 0 everywhere else, so this
        is a no-op on non-notched screens. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* Client-side navigation: pages swap in place, so the custom-element
        registry, fonts, and loaded CSS survive and `a-*` elements upgrade
        instantly. Script rules live in site/AGENTS.md ("ClientRouter"). */}
    <ClientRouter />
    {shouldLoadPostHog && <PostHog />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Anta changelog" href="/changelog.rss" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" type="image/svg+xml" href="/anta-favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    {/*
      Preload the brand fonts so the browser starts fetching them in
      parallel with HTML parsing — without this the font requests don't
      fire until the CSS rule is parsed. This preload is what makes
      `font-display: optional` (see base.css) reliable: optional gives
      the font only a ~100ms block window and never swaps afterward, so
      the fetch has to be in flight from the very start to win that race
      and render the brand font on first paint with no reflow. Without
      the preload, optional would usually miss the window and the page
      would stay in the system fallback for the whole load. `crossorigin`
      is required for fetch-credentials to match @font-face requests;
      without it the preloaded resource doesn't get reused by the
      @font-face fetch and we'd preload twice.
    */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="https://ucarecdn.com/af38fa86-199f-44f5-82d2-3ea2a690dd6c/"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="https://ucarecdn.com/61bd3320-3787-4a92-887e-a5ff7bd6e051/"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="https://ucarecdn.com/03e90df9-d945-4837-b177-cdc408e94bb4/"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {/* Tints mobile Safari's toolbar / URL-bar to match the document
        background. Driven from the theme script below (the theme is a
        manual `.dark` class, not prefers-color-scheme, so a media-based
        meta can't track it). Default is the light value. */}
    {/* The persist id keeps this runtime-mutated meta across swaps, so the
        toolbar tint doesn't snap back to light on navigation. */}
    <meta name="theme-color" content="#fbfafb" data-astro-transition-persist="theme-color" />
    <script is:inline>
      // Apply the theme before paint so there's no flash. Preference
      // order: explicit user choice in localStorage → OS-level
      // prefers-color-scheme. Once the user has clicked the toggle,
      // localStorage holds the preference forever.
      const KEY = 'anta-theme'
      // Mobile-Safari toolbar tint per theme — tracks `--bg-2` in
      // anta's tokens.css (keep in sync if that token changes).
      const THEME_COLOR = { light: '#fbfafb', dark: '#0e0d0f' }
      // Central theme application: flips `.dark` on <html> and keeps the
      // theme-color meta in sync. Exposed so the toggle handler (a
      // separate, later script) reuses the exact same logic.
      const apply = (m) => {
        document.documentElement.classList.toggle('dark', m)
        const tc = document.querySelector('meta[name="theme-color"]')
        if (tc) tc.setAttribute('content', m ? THEME_COLOR.dark : THEME_COLOR.light)
      }
      window.__antaApplyTheme = apply
      const stored = localStorage.getItem(KEY)
      if (stored === 'dark' || stored === 'light') {
        apply(stored === 'dark')
      } else {
        const mql = matchMedia('(prefers-color-scheme: dark)')
        apply(mql.matches)
        // Follow OS changes until the user makes an explicit choice.
        mql.addEventListener('change', (e) => {
          if (!localStorage.getItem(KEY)) apply(e.matches)
        })
      }
    </script>
    {/* Palette — separate axis from light/dark above. One stable <link>; its
        href is the switch point (/themes/default.css is an empty stub, the
        ThemeSwitcher island swaps in e.g. /themes/anta.css). The persist id
        carries the mutated node across swaps, so navigation needs no JS. */}
    <link
      rel="stylesheet"
      id="palette-link"
      href="/themes/default.css"
      data-astro-transition-persist="palette"
    />
    <script is:inline>
      // Apply the stored palette before paint: rewriting the href during head
      // parse keeps the stylesheet render-blocking, so a cold load never
      // flashes the default palette. Keep URLs in sync with ThemeSwitcher.tsx.
      try {
        const palette = localStorage.getItem('anta-palette')
        if (palette === 'anta') {
          document.getElementById('palette-link').href = '/themes/anta.css'
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    {/* The router fetches the destination before it can swap the document.
        This small bar makes that wait visible without delaying the swap. */}
    <div class="navigation-progress" aria-hidden="true"></div>
    <header class="topbar">
      <span class="topbar-title">
        Anta{title && <Fragment><span class="crumb-sep">›</span>{title}</Fragment>}
      </span>
      <Button
        class="menu-toggle"
        priority="tertiary"
        size="large"
        label="MENU"
        iconTrailing="menu"
        aria-label="Open menu"
      />
    </header>
    <div class="layout">
      {/* Persisted: ClientRouter moves this exact node into each new page, so
          sidebar scroll and the ThemeSwitcher island survive navigation. The
          stale aria-current is re-pointed on astro:page-load below. */}
      <aside class="sidebar" transition:persist="sidebar">
        <span class="logo">
          <a class="logo-home" href="https://anta.design/" aria-label="Anta home">
            <img src="/anta-logo.svg" alt="" width="32" height="32" />
            <span class="logo-label">Anta</span>
          </a>
          <Button class="theme-toggle" priority="tertiary" size="large" aria-label="Switch theme">
            <Icon shape="sun" size={18} />
            <Icon shape="moon" size={18} />
          </Button>
        </span>
        <menu>
          <li><a href="/" aria-current={isCurrent('/') ? 'page' : undefined}><Icon shape="info" size={18} /> Overview</a></li>
          <li><a href="/comparison/" aria-current={isCurrent('/comparison/') ? 'page' : undefined}><Icon shape="table-2" size={18} /> Comparison</a></li>
          <li><a href="/install/" aria-current={isCurrent('/install/') ? 'page' : undefined}><Icon shape="download" size={18} /> Install and configure</a></li>
          <li><a href="/normalization/" aria-current={isCurrent('/normalization/') ? 'page' : undefined}><Icon shape="book-a" size={18} /> Normalization</a></li>
        </menu>
        <hr class="sidebar-separator" />
        <menu>
          <li><a href="/colors/" aria-current={isCurrent('/colors/') ? 'page' : undefined}><Icon shape="swatch-book" size={18} /> Colors</a></li>
          <li class="theming-nav-item">
            <a href="/theming/" aria-current={isCurrent('/theming/') ? 'page' : undefined}><Icon shape="theme" size={18} /> Theming</a>
            <div class="theming-switcher"><ThemeSwitcher client:load /></div>
          </li>
          <li><a href="/accessibility/" aria-current={isCurrent('/accessibility/') ? 'page' : undefined}><Icon shape="hat-glasses" size={18} /> Accessibility</a></li>
          <li><a href="/credits/" aria-current={isCurrent('/credits/') ? 'page' : undefined}><Icon shape="heart-handshake" size={18} /> Credits</a></li>
        </menu>
        <hr class="sidebar-separator" />
        <div class="package-links">
          <a
            class="package-link"
            href="https://www.npmjs.com/package/@antadesign/anta?activeTab=versions"
            target="_blank"
            rel="noopener"
            aria-label={npmVersion ? `npm package ${npmVersion}` : 'npm package'}
          >
            <Icon shape="cube" size={18} /> {npmVersion ? `npm ${npmVersion}` : 'npm'}
          </a>
          <a
            class="package-link github-link"
            href="https://github.com/antithesishq/anta"
            target="_blank"
            rel="noopener"
            aria-label="GitHub repository"
          >
            <Icon shape="github-logo" size={16} /> GitHub
          </a>
        </div>
        <menu>
          <li><a href="/changelog/" aria-current={isCurrent('/changelog/') ? 'page' : undefined}><Icon shape="scroll-text" size={18} /> Changelog</a></li>
        </menu>
        <h4>Components</h4>
        <menu>
          <li><a href="/title/" aria-current={isCurrent('/title/') ? 'page' : undefined}><Icon shape="case-sensitive" size={18} /> Title</a></li>
          <li><a href="/text/" aria-current={isCurrent('/text/') ? 'page' : undefined}><Icon shape="text-initial" size={18} /> Text</a></li>
          <li><a href="/tag/" aria-current={isCurrent('/tag/') ? 'page' : undefined}><Icon shape="tag" size={18} /> Tag</a></li>
          <li><a href="/tooltip/" aria-current={isCurrent('/tooltip/') ? 'page' : undefined}><Icon shape="chat" size={18} /> Tooltip</a></li>
          <li><a href="/icon/" aria-current={isCurrent('/icon/') ? 'page' : undefined}><Icon shape="bug" size={18} /> Icon</a></li>
          <li><a href="/loader/" aria-current={isCurrent('/loader/') ? 'page' : undefined}><Icon shape="loader-docs" size={18} /> Loader</a></li>
          <li><a href="/progress/" aria-current={isCurrent('/progress/') ? 'page' : undefined}><Icon shape="hourglass" size={18} /> Progress</a></li>
        </menu>
        <hr class="sidebar-separator" />
        <menu>
          <li><a href="/button/" aria-current={isCurrent('/button/') ? 'page' : undefined}><Icon shape="pointer" size={18} /> Button</a></li>
          <li><a href="/checkbox/" aria-current={isCurrent('/checkbox/') ? 'page' : undefined}><Icon shape="square-check-big" size={18} /> Checkbox</a></li>
          <li><a href="/radio/" aria-current={isCurrent('/radio/') ? 'page' : undefined}><Icon shape="circle-dot" size={18} /> Radio</a></li>
          <li><a href="/switch/" aria-current={isCurrent('/switch/') ? 'page' : undefined}><Icon shape="toggle-right" size={18} /> Switch</a></li>
          <li><a href="/slider/" aria-current={isCurrent('/slider/') ? 'page' : undefined}><Icon shape="settings-2" size={18} /> Slider</a></li>
          <li><a href="/tabs/" aria-current={isCurrent('/tabs/') ? 'page' : undefined}><Icon shape="tabs" size={18} /> Tabs</a></li>
          <li><a href="/steps/" aria-current={isCurrent('/steps/') ? 'page' : undefined}><Icon shape="footprints" size={18} /> Steps</a></li>
        </menu>
        <hr class="sidebar-separator" />
        <menu>
          <li><a href="/expander/" aria-current={isCurrent('/expander/') ? 'page' : undefined}><Icon shape="square-chevron-right" size={18} /> Expander</a></li>
          <li><a href="/menu/" aria-current={isCurrent('/menu/') ? 'page' : undefined}><Icon shape="square-menu" size={18} /> Menu</a></li>
        </menu>
        <hr class="sidebar-separator" />
        <menu>
          <li><a href="/input/" aria-current={isCurrent('/input/') ? 'page' : undefined}><Icon shape="text-cursor-input" size={18} /> Input</a></li>
          <li><a href="/input-autocomplete/" aria-current={isCurrent('/input-autocomplete/') ? 'page' : undefined}><Icon shape="search-slash" size={18} /> InputAutocomplete</a></li>
          <li><a href="/input-date/" aria-current={isCurrent('/input-date/') ? 'page' : undefined}><Icon shape="calendar-days" size={18} /> InputDate</a></li>
          <li><a href="/input-time/" aria-current={isCurrent('/input-time/') ? 'page' : undefined}><Icon shape="clock" size={18} /> InputTime</a></li>
          <li><a href="/select/" aria-current={isCurrent('/select/') ? 'page' : undefined}><Icon shape="square-chevron-down" size={18} /> Select</a></li>
          <li><a href="/select-faceted/" aria-current={isCurrent('/select-faceted/') ? 'page' : undefined}><Icon shape="filter" size={18} /> SelectFaceted</a></li>
        </menu>
        <hr class="sidebar-separator" />
        <menu>
          <li><a href="/banner/" aria-current={isCurrent('/banner/') ? 'page' : undefined}><Icon shape="banner" size={18} /> Banner</a></li>
          <li><a href="/card/" aria-current={isCurrent('/card/') ? 'page' : undefined}><Icon shape="card" size={18} /> Card</a></li>
          <li><a href="/dialog/" aria-current={isCurrent('/dialog/') ? 'page' : undefined}><Icon shape="dialog" size={18} /> Dialog</a></li>
          <li><a href="/toaster/" aria-current={isCurrent('/toaster/') ? 'page' : undefined}><Icon shape="toaster" size={18} /> Toaster</a></li>
        </menu>
        <h4>Packages</h4>
        <menu>
          <li><a href="/table/" aria-current={isCurrent('/table/') ? 'page' : undefined}><Icon shape="table-2" size={18} /> Table</a></li>
          <li><a href="/stickers/" aria-current={isCurrent('/stickers/') ? 'page' : undefined}><Icon shape="sticker" size={18} /> Stickers</a></li>
        </menu>
      </aside>
      <main class="content">
        {/* Mobile-only: opens the "On this page" TOC as a right-side
            slide-out (the .toc-rail is hidden on mobile otherwise).
            Absolutely positioned in the content's top-right corner. */}
        {!hideToc && (
          <Button
            class="toc-toggle"
            priority="tertiary"
            underline="dotted"
            label="On this page"
            aria-label="Open table of contents"
            data-toc-pending
          />
        )}
        <slot />
      </main>
      {!hideToc && (
        <aside class="toc-rail">
          <a-toc max-level={tocMaxLevel}></a-toc>
        </aside>
      )}
    </div>
    <div class="backdrop" aria-hidden="true"></div>

    <script>
      import type { TransitionBeforeSwapEvent } from 'astro:transitions/client'

      // Runs once per session (ClientRouter never re-runs a seen script), so
      // handlers are document-delegated and per-page work hangs off astro:*
      // events; never hold a reference to one page's DOM.

      // Two mobile slide-outs share the backdrop: the nav sidebar and the
      // "On this page" TOC; opening one closes the other. State lives in
      // body.dataset, which the body swap resets, closing drawers on nav.
      const setMenu = (open: boolean) => {
        document.body.dataset.menuOpen = open ? 'true' : 'false'
        if (open) document.body.dataset.tocOpen = 'false'
      }
      const setToc = (open: boolean) => {
        document.body.dataset.tocOpen = open ? 'true' : 'false'
        if (open) document.body.dataset.menuOpen = 'false'
      }
      const closeAll = () => {
        setMenu(false)
        setToc(false)
      }

      // Show immediate acknowledgement while ClientRouter prepares the next
      // document. The incoming <html> replaces this attribute during the swap;
      // clear it explicitly as well for the current document and accessibility
      // tree.
      const setNavigationPending = (pending: boolean) => {
        document.documentElement.toggleAttribute('data-navigation-pending', pending)
        document.documentElement.setAttribute('aria-busy', pending ? 'true' : 'false')
      }
      document.addEventListener('astro:before-preparation', () => setNavigationPending(true))
      document.addEventListener('astro:after-swap', () => setNavigationPending(false))

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement
        if (!target.closest) return
        if (target.closest('.menu-toggle, .topbar-title')) {
          setMenu(document.body.dataset.menuOpen !== 'true')
        } else if (target.closest('.toc-toggle')) {
          setToc(document.body.dataset.tocOpen !== 'true')
        } else if (target.closest('.backdrop')) {
          closeAll()
        } else if (target.closest('.toc-rail')) {
          // Tapping a TOC entry closes the panel (router hash navs fire no
          // hashchange; the listener below covers native jumps).
          setToc(false)
        }
      })
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAll()
      })
      window.addEventListener('hashchange', () => setToc(false))

      // `<a-toc>` only renders when the page has enough headings to navigate.
      // Keep the mobile trigger hidden until it reports that it has entries,
      // so overview-style pages never open an empty panel.
      document.addEventListener('anta-tocchange', (e) => {
        const target = e.target
        if (!(target instanceof HTMLElement) || target.localName !== 'a-toc') return
        const hasEntries = Boolean((e as CustomEvent<{ hasEntries?: boolean }>).detail?.hasEntries)
        document.querySelector('.toc-toggle')?.toggleAttribute('data-toc-pending', !hasEntries)
        if (!hasEntries) setToc(false)
      })

      // Theme toggle: flip `.dark` (and the theme-color meta) via the head
      // script's shared apply, then persist the choice. Cold loads apply
      // pre-paint in the head script; swaps re-stamp below.
      const THEME_KEY = 'anta-theme'
      const applyTheme = (window as any).__antaApplyTheme
        ?? ((m: boolean) => document.documentElement.classList.toggle('dark', m))
      document.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement).closest?.('.theme-toggle')) return
        const nextDark = !document.documentElement.classList.contains('dark')
        applyTheme(nextDark)
        localStorage.setItem(THEME_KEY, nextDark ? 'dark' : 'light')
        ;(window as any).posthog?.capture('dark_mode_toggled', { mode: nextDark ? 'dark' : 'light' })
      })

      // Swaps replace <html>'s attributes wholesale, wiping the runtime
      // `.dark`: stamp it onto the incoming document. (The theme-color meta
      // and palette <link> persist by attribute and need nothing here.) The
      // sidebar node persists too, but the move zeroes its scroll offset, so
      // carry scrollTop across by hand.
      let sidebarScroll = 0
      document.addEventListener('astro:before-swap', (e) => {
        sidebarScroll = document.querySelector('.sidebar')?.scrollTop ?? 0
        ;(e as TransitionBeforeSwapEvent).newDocument.documentElement.classList.toggle(
          'dark',
          document.documentElement.classList.contains('dark'),
        )
      })
      document.addEventListener('astro:after-swap', () => {
        const sidebar = document.querySelector('.sidebar')
        if (sidebar) sidebar.scrollTop = sidebarScroll
      })

      // The persisted sidebar keeps the previous page's aria-current:
      // re-point it at the new URL. Idempotent on the initial load.
      document.addEventListener('astro:page-load', () => {
        const here = location.pathname.replace(/\/+$/, '') || '/'
        for (const a of document.querySelectorAll<HTMLAnchorElement>('.sidebar menu a')) {
          const linkPath = new URL(a.href).pathname.replace(/\/+$/, '') || '/'
          if (linkPath === here) a.setAttribute('aria-current', 'page')
          else a.removeAttribute('aria-current')
        }
      })
    </script>

    <script>
      import '@antadesign/anta/elements'
      import '@antadesign/stickers/elements'
      import '../components/a-toc.ts'

      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement)?.closest?.('code, .copyable') as HTMLElement | null
        if (!target) return
        if (target.tagName === 'CODE' && target.parentElement?.tagName === 'PRE') return
        const text = target.textContent ?? ''
        if (!text) return
        navigator.clipboard.writeText(text).then(() => {
          target.addEventListener('animationend', () => delete target.dataset.copied, { once: true })
          target.dataset.copied = text
          ;(window as any).posthog?.capture('code_snippet_copied', { snippet_length: text.length })
        }).catch(() => {})
      })

      document.addEventListener('click', (e) => {
        const anchor = (e.target as HTMLElement)?.closest?.('a') as HTMLAnchorElement | null
        if (!anchor) return
        if (anchor.closest('.package-links')) {
          const href = anchor.href ?? ''
          if (href.includes('github.com')) {
            ;(window as any).posthog?.capture('github_link_clicked')
          } else if (href.includes('npmjs.com')) {
            ;(window as any).posthog?.capture('npm_link_clicked')
          }
        }
      })

      // Expressive-code copy buttons: instead of EC's "Copied!" tooltip
      // (hidden via CSS), flip the copy glyph to a green check for a
      // moment by toggling `[data-anta-copied]` on the button.
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement)?.closest?.('.expressive-code .copy button') as
          | (HTMLElement & { _antaCopyTimer?: ReturnType<typeof setTimeout> })
          | null
        if (!btn) return
        btn.dataset.antaCopied = 'true'
        clearTimeout(btn._antaCopyTimer)
        btn._antaCopyTimer = setTimeout(() => { delete btn.dataset.antaCopied }, 1400)
      })

      // Foldable code blocks: clicking (or Enter/Space on) the header bar of a
      // framed block — titled, terminal, or one authored `folded` (which gets
      // a header via lib/ec-foldable.mjs) — toggles `data-folded` on the
      // figure. base.css animates the collapse + chevron; the EC plugin baked
      // the header's tabindex/role/aria-expanded. `.copy` is a sibling of
      // `.header`, not a descendant, so copy clicks never fold.
      const FOLD_SEL =
        '.expressive-code .frame.has-title > .header, .expressive-code .frame.is-terminal > .header, .expressive-code .frame[data-foldable] > .header'
      const toggleFold = (header: HTMLElement) => {
        const frame = header.closest('.frame') as HTMLElement | null
        if (!frame) return
        const folded = frame.toggleAttribute('data-folded')
        header.setAttribute('aria-expanded', folded ? 'false' : 'true')
      }
      document.addEventListener('click', (e) => {
        const header = (e.target as HTMLElement)?.closest?.(FOLD_SEL) as HTMLElement | null
        if (header) toggleFold(header)
      })
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return
        const header = (e.target as HTMLElement)?.closest?.(FOLD_SEL) as HTMLElement | null
        if (!header) return
        e.preventDefault()
        toggleFold(header)
      })

    </script>
  </body>
</html>

