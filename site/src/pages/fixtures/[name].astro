---
import antaStylesheet from '@antadesign/anta/bundle.css?url'
import SwitchFixture from '../../../../fixtures/switch/fixture'
import '../../styles/base.css'

export function getStaticPaths() {
  return [{ params: { name: 'switch' } }]
}

const name = Astro.params.name
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{name} fixture</title>
    <link rel="stylesheet" href={antaStylesheet} />
    <link rel="stylesheet" href="/themes/antune.css" />
  </head>
  <body>
    <div class="fixture-stage">
      <SwitchFixture client:load />
    </div>
    <script>import '@antadesign/anta/elements'</script>
  </body>
</html>

<style>
  .fixture-stage {
    box-sizing: border-box;
    min-height: 100svh;
    padding: clamp(24px, 6vw, 72px);
    background: var(--bg-0);
  }

  .fixture-stage :global([data-fixture]) {
    display: grid;
    max-width: 640px;
    gap: 24px;
  }

  .fixture-stage :global([data-fixture-form]) {
    min-height: 72px;
    padding: 20px;
    border: 1px solid var(--border-2);
    border-radius: 12px;
    background: var(--bg-1);
  }

  .fixture-stage :global([data-fixture-empty]) {
    margin: 0;
    color: var(--text-3);
  }

  .fixture-stage :global([data-fixture-state]) {
    color: var(--text-2);
    font-size: 14px;
  }

  .fixture-stage :global([data-fixture-controls]) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
