---
import '@antadesign/anta/tokens.css'
import '@antadesign/anta/reset.css'
import '@antadesign/anta/theme-antithesis.css'
import '../styles/fonts-antithesis.css'

const sections = [
  { title: 'Get started', href: '/install/', image: 'get-started.png', description: 'Install Anta, configure your runtime, and render your first component.' },
  { title: 'Foundations', href: '/theming/', image: 'foundations.png', description: 'Explore the design tokens, color scales, and themes behind Anta.' },
  { title: 'Components', href: '/button/', image: 'components.png', description: 'Browse components, try their states, and see how to use them.' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Built on modern Web Components, with typed JSX support for React and Preact." />
    <link rel="icon" href="/anta-favicon.svg" type="image/svg+xml" />
    <title>Anta Design System</title>
    <script is:inline>
      const preference = localStorage.getItem('anta-theme')
      document.documentElement.classList.toggle('dark',
        preference === 'dark' || (preference !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches))
    </script>
  </head>
  <body>
    <header class="landing-header">
      <a href="/" class="brand"><img src="/landing/brand.svg" alt="Anta Design System" width="220" height="54" /></a>
      <nav aria-label="Main navigation">
        {sections.map(({ title, href }) => <a href={href}>{title}</a>)}
      </nav>
      <div class="theme-picker" role="group" aria-label="Color theme">
        <button type="button" data-theme="light" aria-pressed="false"><img src="/landing/sun.svg" alt="" width="15" height="15" />Light</button>
        <button type="button" data-theme="dark" aria-pressed="false"><img src="/landing/moon.svg" alt="" width="16" height="16" />Dark</button>
      </div>
    </header>

    <main class="landing">
      <div class="landing-content">
        <section class="hero" aria-labelledby="landing-title">
          <h1 id="landing-title">An Opinionated <span class="keep-together">AI-Ready</span> Design System</h1>
          <p>Built on modern Web Components, with typed JSX support for React and Preact.</p>

          <div class="hero-art" aria-hidden="true">
            <div class="button-drawing">
              <img src="/landing/button-outline.svg" alt="" />
              <span>Button</span>
            </div>
            <div class="drawing-circle"></div>
            <div class="collaborator vlad">
              <img class="cursor" src="/landing/cursor.svg" alt="" />
              <img class="portrait" src="/landing/vlad.png" alt="" width="52" height="52" />
              <div><b>Vlad K.</b><span>Design Director</span></div>
            </div>
            <div class="collaborator conrad">
              <img class="cursor" src="/landing/cursor.svg" alt="" />
              <img class="portrait" src="/landing/conrad.png" alt="" width="52" height="52" />
              <div><b>Conrad S.</b><span>Senior Software Engineer</span></div>
            </div>
          </div>
        </section>

        <ul class="section-cards">
          <li class="floating-check" aria-hidden="true"><img src="/landing/check.svg" alt="" /></li>
          {sections.map(({ title, href, image, description }) => (
            <li>
              <a class="section-card" href={href}>
                <img class="card-cover" src={`/landing/${image}`} alt={title} width="398" height="198" />
                <p>{description}</p>
              </a>
            </li>
          ))}
        </ul>

        <footer>
          <a class="readme" href="/llms.txt"><img src="/landing/folder.png" alt="" width="84" height="70" />Docs for AI</a>
          <small>© 2026 Antithesis</small>
        </footer>
      </div>
    </main>

    <script>
      const choices = document.querySelectorAll<HTMLButtonElement>('.theme-picker button')
      const preference = matchMedia('(prefers-color-scheme: dark)')

      function applyTheme(dark: boolean) {
        document.documentElement.classList.toggle('dark', dark)
        for (const choice of choices) {
          choice.setAttribute('aria-pressed', String(choice.dataset.theme === (dark ? 'dark' : 'light')))
        }
      }

      applyTheme(document.documentElement.classList.contains('dark'))
      for (const choice of choices) {
        choice.addEventListener('click', () => {
          const dark = choice.dataset.theme === 'dark'
          localStorage.setItem('anta-theme', dark ? 'dark' : 'light')
          applyTheme(dark)
        })
      }

      preference.addEventListener('change', ({ matches }) => {
        if (!localStorage.getItem('anta-theme')) applyTheme(matches)
      })
    </script>
  </body>
</html>

<style>
  body {
    background: var(--bg-1);
    color: var(--text-1);
    font-family: var(--sans-serif);
  }

  .landing-header,
  .landing-content {
    width: min(81%, 1356px);
    margin-inline: auto;
  }

  .landing-header {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 32px);
    min-height: 90px;
  }

  .brand { margin-inline-end: auto; }

  nav,
  .theme-picker {
    display: flex;
    align-items: center;
  }

  nav { gap: clamp(16px, 2.4vw, 40px); }

  nav a {
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover { text-decoration: underline; }

  .theme-picker {
    gap: 4px;
    padding: 4px;
    border-radius: 9px;
    background: var(--bg-4-brand);
  }

  .theme-picker button {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 9px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--text-2-brand);
    cursor: pointer;
  }

  .theme-picker button[aria-pressed='true'] {
    background: var(--bg-1);
    color: var(--text-1);
  }

  .landing {
    margin-inline: clamp(12px, 1.2vw, 20px);
    border-radius: 32px 32px 0 0;
    overflow: clip;
    background:
      radial-gradient(ellipse at 4% 14%, var(--bg-5-brand), transparent 62%),
      radial-gradient(ellipse at 96% 0%, var(--bg-4-brand), transparent 58%),
      radial-gradient(ellipse at 32% 83%, var(--bg-5-brand), transparent 65%),
      var(--bg-2);
  }

  :global(.dark) .brand img {
    filter: invert(1);
  }

  .hero {
    position: relative;
    padding-block: clamp(50px, 5.4vw, 92px) clamp(86px, 8.2vw, 140px);
  }

  .hero h1 {
    position: relative;
    z-index: 1;
    max-width: min(17em, 59%);
    margin: 0;
    font-family: inherit;
    font-size: clamp(34px, 3.1vw, 48px);
    line-height: 1.15;
    font-weight: 650;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .keep-together { white-space: nowrap; }

  .hero p {
    position: relative;
    z-index: 1;
    max-width: 44%;
    margin: 22px 0 0;
    font-size: 17px;
  }

  .hero-art {
    position: absolute;
    top: clamp(56px, 5.8vw, 99px);
    right: 0;
    width: 54%;
    height: 222px;
    pointer-events: none;
  }

  .button-drawing {
    position: absolute;
    left: 38%;
    top: 0;
    width: 41%;
    display: grid;
    place-items: center;
  }

  .button-drawing img { width: 100%; }

  .button-drawing img,
  .cursor,
  .card-cover,
  .floating-check img,
  .theme-picker img {
    filter: hue-rotate(105deg);
  }

  .button-drawing span {
    position: absolute;
    color: transparent;
    font-size: clamp(25px, 2.6vw, 45px);
    font-weight: 750;
    letter-spacing: 0.04em;
    -webkit-text-stroke: 1px var(--border-3-brand);
  }

  .drawing-circle {
    position: absolute;
    top: 0;
    left: 79%;
    width: 12%;
    aspect-ratio: 1;
    border: 1px solid var(--border-4-brand);
    border-radius: 50%;
    background: color-mix(in oklch, white 30%, transparent);
  }

  .drawing-circle::after {
    position: absolute;
    top: 50%;
    left: 100%;
    width: 260px;
    height: 1px;
    background: var(--border-4-brand);
    content: '';
  }

  .collaborator {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 11px;
    width: min(36%, 259px);
    min-width: 172px;
    padding: 8px 12px;
    background: var(--bg-1);
    border-radius: 32px;
  }

  .vlad {
    left: 0;
    top: 52%;
    border-start-end-radius: 0;
  }

  .conrad {
    right: 0;
    top: 65%;
    border-start-start-radius: 0;
  }

  .portrait {
    width: clamp(33px, 3vw, 52px);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
  }

  .collaborator span {
    display: block;
    color: var(--text-3);
    line-height: 1.35;
  }

  .cursor {
    position: absolute;
    top: -22px;
    width: 22px;
  }

  .vlad .cursor {
    right: -24px;
    transform: scaleX(-1);
  }

  .conrad .cursor { left: -24px; }

  .section-cards {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 1.3vw, 21px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .section-cards li { min-width: 0; }

  .floating-check {
    position: absolute;
    inset: auto auto 100% 14%;
    display: grid;
    place-items: center;
    width: clamp(44px, 5vw, 88px);
    aspect-ratio: 1;
    transform: translateY(26%) rotate(-18deg);
    border: 1px solid white;
    border-radius: 12px;
    background: color-mix(in oklch, white 20%, transparent);
    pointer-events: none;
  }

  .floating-check img { width: 70%; }

  .section-card {
    position: relative;
    display: block;
    height: 100%;
    padding: clamp(12px, 1.17vw, 20px);
    padding-top: 16%;
    isolation: isolate;
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
  }

  .section-card::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: url('/landing/folder-card.svg') center / 100% 100% no-repeat;
    content: '';
  }


  .section-card:hover p { text-decoration: underline; }

  .card-cover {
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .section-card p {
    margin: 20px 0 26px;
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.35;
  }

  footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    padding-block: clamp(32px, 4vw, 66px) 48px;
  }

  .readme {
    display: flex;
    align-items: end;
    gap: 12px;
    color: inherit;
    font-size: clamp(18px, 2vw, 28px);
    font-weight: 650;
  }

  footer small { color: var(--text-3); }

  @media (max-width: 1000px) {
    .landing-header,
    .landing-content { width: 90%; }

    .hero h1 { max-width: 56%; }
  }

  @media (max-width: 760px) {
    .landing-header {
      flex-wrap: wrap;
      padding-block: 14px;
    }

    .brand img {
      width: 165px;
      height: auto;
    }

    nav {
      order: 1;
      flex: 1 0 100%;
      flex-wrap: wrap;
    }

    .hero { padding-bottom: 38px; }

    .hero h1,
    .hero p { max-width: 100%; }

    .hero-art,
    .floating-check { display: none; }

    .section-cards { grid-template-columns: 1fr; }

    .section-card { padding-top: 14%; }

    footer { align-items: center; }
  }
</style>
