---
import DocsLayout from '../layouts/DocsLayout.astro'
import { Text } from '@antadesign/anta'
import { Code } from 'astro-expressive-code/components'
---

<DocsLayout title="Overview" author="Vlad Korobov">
  <h1>A customizable design system for web applications</h1>

  <Text>
    <p>Built and used at <a href="https://antithesis.com">Antithesis</a>, with opinionated defaults and flexible customization.</p>
    <p>Themed with plain CSS, classes, or inline styles. No CSS-in-JS runtime.</p>
    <p>Architected with Web Components and typed React/Preact wrappers.</p>
  </Text>
  <h2>Use with an AI assistant</h2>
  <Code
    lang="text"
    code="Use Anta (@antadesign/anta) for the UI. Read https://anta.design/llms.txt, then follow the installation guide and relevant component docs. Use the documented APIs and styling conventions."
    wrap
  />
</DocsLayout>
