{
  "name": "@antadesign/table",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/entries/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/types/entries/bundle.d.ts",
      "import": "./dist/bundle.js"
    },
    "./core": {
      "types": "./dist/types/entries/core.d.ts",
      "import": "./dist/core.js"
    },
    "./elements": {
      "types": "./dist/types/entries/elements.d.ts",
      "import": "./dist/elements.js"
    },
    "./elements/a-table": {
      "types": "./dist/types/entries/elements/a-table.d.ts",
      "import": "./dist/elements/a-table.js"
    },
    "./table.css": "./dist/table.css"
  },
  "sideEffects": [
    "./dist/bundle.js",
    "./dist/elements.js",
    "./dist/elements/*.js",
    "./dist/*.css",
    "./dist/chunks/*.js",
    "./src/entries/bundle.ts",
    "./src/entries/elements.ts",
    "./src/entries/elements/*.ts",
    "./src/elements/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "pnpm run build",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false -p tsconfig.json",
    "check:package": "node scripts/verify-package.mjs",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "test": "node --test tests/core.test.mjs tests/types.test.mjs",
    "test:browser": "node --test tests/table.browser.test.mjs",
    "demo": "node tests/demo.mjs"
  },
  "peerDependencies": {
    "@antadesign/anta": "^0.3.38",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@antadesign/anta": "workspace:*",
    "@antadesign/virtual-scroll": "workspace:*",
    "@types/react": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "packageManager": "pnpm@10.11.1",
  "main": "dist/index.js",
  "types": "dist/types/entries/index.d.ts",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
